<?xml version="1.0"?>
<!-- Unit 1 body: cylindrical, three layers (drive/battery, extinguisher, sensors), LiDAR on top.
     Sensor/drive interfaces match fire_robot.urdf.xacro (see docs/robot_interface_inventory.md). -->
<robot name="fire_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Dimensions [m]. base_link origin lies on the ground under the wheel axle (= rotation center). -->
  <xacro:property name="body_radius" value="0.175"/>
  <xacro:property name="body_clearance" value="0.03"/>
  <!-- Layer boundaries (z): lower 0.03-0.10, middle 0.10-0.26, upper 0.26-0.38 -->
  <xacro:property name="lower_top" value="0.10"/>
  <xacro:property name="middle_top" value="0.26"/>
  <xacro:property name="upper_top" value="0.38"/>

  <!-- Drive: same values as the old body, so DiffDrive limits and odometry stay unchanged -->
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="wheel_separation" value="0.28"/>
  <xacro:property name="wheel_mass" value="0.2"/>
  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_x" value="-0.11"/>

  <!-- Heavy parts low: battery + lower deck carry most of the mass -->
  <xacro:property name="battery_mass" value="1.5"/>
  <xacro:property name="lower_mass" value="0.8"/>
  <xacro:property name="middle_mass" value="0.4"/>
  <xacro:property name="upper_mass" value="0.3"/>
  <xacro:property name="can_mass" value="0.4"/>

  <!-- Sensors face forward (yaw 0); mission_node reads their positions from TF.
       Camera lenses sit just outside the shell, so no part of the body is in view. -->
  <xacro:property name="lidar_x" value="0.0"/>
  <!-- Scan plane below the lowest furniture top (coffee table, 0.45) used by the map -->
  <xacro:property name="lidar_z" value="0.41"/>
  <!-- Thermal camera must stay on the center line (ALIGN turns the heading onto it) -->
  <xacro:property name="thermal_x" value="0.18"/>
  <xacro:property name="thermal_z" value="0.33"/>
  <xacro:property name="thermal_hfov" value="1.0472"/>
  <xacro:property name="rgb_y" value="0.045"/>
  <xacro:property name="camera_depth" value="0.03"/>

  <!-- Nozzle link center; tip at x 0.19, z 0.11 (spray_nozzle defaults) -->
  <xacro:property name="nozzle_x" value="0.175"/>
  <xacro:property name="nozzle_z" value="0.11"/>
  <xacro:property name="nozzle_length" value="0.03"/>

  <xacro:property name="can_radius" value="0.033"/>
  <xacro:property name="can_height" value="0.15"/>
  <xacro:property name="can_x" value="-0.06"/>

  <material name="white"><color rgba="0.9 0.9 0.9 1"/></material>
  <material name="red"><color rgba="0.9 0.1 0.1 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="copper"><color rgba="0.8 0.5 0.2 1"/></material>

  <xacro:macro name="cylinder_inertial" params="mass radius length z">
    <inertial>
      <origin xyz="0 0 ${z}"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass*(3*radius*radius + length*length)/12}" ixy="0" ixz="0"
               iyy="${mass*(3*radius*radius + length*length)/12}" iyz="0"
               izz="${mass*radius*radius/2}"/>
    </inertial>
  </xacro:macro>

  <!-- Body layer: one cylinder segment from z_bottom to z_top (base_link frame) -->
  <xacro:macro name="body_layer" params="name z_bottom z_top mass material">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 ${(z_bottom + z_top)/2}"/>
        <geometry><cylinder radius="${body_radius}" length="${z_top - z_bottom}"/></geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${(z_bottom + z_top)/2}"/>
        <geometry><cylinder radius="${body_radius}" length="${z_top - z_bottom}"/></geometry>
      </collision>
      <xacro:cylinder_inertial mass="${mass}" radius="${body_radius}"
                               length="${z_top - z_bottom}" z="${(z_bottom + z_top)/2}"/>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
    </joint>
  </xacro:macro>

  <!-- Dummy root without inertia (KDL does not support an inertial root link) -->
  <link name="base_footprint"/>
  <link name="base_link"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- ===== Lower layer: drive wheels, casters, battery ===== -->
  <xacro:body_layer name="lower_body" z_bottom="${body_clearance}" z_top="${lower_top}"
                    mass="${lower_mass}" material="grey"/>

  <link name="battery_link">
    <visual>
      <geometry><box size="0.14 0.20 0.05"/></geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="${battery_mass}"/>
      <inertia ixx="${battery_mass*(0.20*0.20 + 0.05*0.05)/12}" ixy="0" ixz="0"
               iyy="${battery_mass*(0.14*0.14 + 0.05*0.05)/12}" iyz="0"
               izz="${battery_mass*(0.14*0.14 + 0.20*0.20)/12}"/>
    </inertial>
  </link>
  <joint name="battery_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery_link"/>
    <origin xyz="0 0 0.06"/>
  </joint>

  <xacro:macro name="wheel" params="side y_sign">
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <origin rpy="${pi/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}" ixy="0" ixz="0"
                 iyy="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}" iyz="0"
                 izz="${wheel_mass*wheel_radius*wheel_radius/2}"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y_sign*wheel_separation/2} ${wheel_radius}"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel side="left" y_sign="1"/>
  <xacro:wheel side="right" y_sign="-1"/>

  <!-- Frictionless ball casters front and back -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} 0 ${caster_radius}"/>
    </joint>
    <gazebo reference="${name}_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:caster name="caster" x="${caster_x}"/>
  <xacro:caster name="front_caster" x="${-caster_x}"/>

  <!-- Ring-shaped charging contact on the bottom (visual only): copper ring, grey center -->
  <link name="charging_contact_link">
    <visual>
      <origin xyz="0 0 -0.002"/>
      <geometry><cylinder radius="0.09" length="0.004"/></geometry>
      <material name="copper"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.0025"/>
      <geometry><cylinder radius="0.07" length="0.005"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="charging_contact_joint" type="fixed">
    <parent link="base_link"/>
    <child link="charging_contact_link"/>
    <origin xyz="0 0 ${body_clearance}"/>
  </joint>

  <!-- Floor projector at the front bottom, tilted down toward the floor ahead -->
  <link name="projector_link">
    <visual>
      <geometry><box size="0.03 0.05 0.03"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="projector_joint" type="fixed">
    <parent link="base_link"/>
    <child link="projector_link"/>
    <origin xyz="0.165 0 0.07" rpy="0 1.0 0"/>
  </joint>

  <!-- ===== Middle layer: extinguisher can, weight sensor, nozzle ===== -->
  <xacro:body_layer name="middle_body" z_bottom="${lower_top}" z_top="${middle_top}"
                    mass="${middle_mass}" material="white"/>

  <!-- Load cell under the can (frame only) -->
  <link name="weight_sensor_link"/>
  <joint name="weight_sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="weight_sensor_link"/>
    <origin xyz="${can_x} 0 ${lower_top}"/>
  </joint>

  <link name="extinguisher_can_link">
    <visual>
      <origin xyz="0 0 ${can_height/2}"/>
      <geometry><cylinder radius="${can_radius}" length="${can_height}"/></geometry>
      <material name="red"/>
    </visual>
    <xacro:cylinder_inertial mass="${can_mass}" radius="${can_radius}"
                             length="${can_height}" z="${can_height/2}"/>
  </link>
  <joint name="extinguisher_can_joint" type="fixed">
    <parent link="weight_sensor_link"/>
    <child link="extinguisher_can_link"/>
  </joint>

  <!-- Extinguisher nozzle at the front, aimed forward (+x) -->
  <link name="nozzle_link">
    <visual>
      <origin rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="0.012" length="${nozzle_length}"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="nozzle_joint" type="fixed">
    <parent link="base_link"/>
    <child link="nozzle_link"/>
    <origin xyz="${nozzle_x} 0 ${nozzle_z}"/>
  </joint>

  <!-- Spray particles are a separate model (fire_mission/models/spray.sdf) that the
       spray_nozzle node spawns in front of the nozzle while spraying. -->

  <!-- ===== Upper layer: cameras, speaker, beacon band ===== -->
  <xacro:body_layer name="upper_body" z_bottom="${middle_top}" z_top="${upper_top}"
                    mass="${upper_mass}" material="white"/>

  <link name="thermal_link">
    <visual>
      <origin xyz="${-camera_depth/2} 0 0"/>
      <geometry><box size="${camera_depth} 0.04 0.03"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="thermal_joint" type="fixed">
    <parent link="base_link"/>
    <child link="thermal_link"/>
    <origin xyz="${thermal_x} 0 ${thermal_z}"/>
  </joint>

  <!-- RGB camera beside the thermal camera, same lens plane and heading (frame/visual only) -->
  <link name="rgb_camera_link">
    <visual>
      <origin xyz="${-camera_depth/2} 0 0"/>
      <geometry><box size="${camera_depth} 0.04 0.03"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="rgb_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rgb_camera_link"/>
    <origin xyz="${thermal_x} ${rgb_y} ${thermal_z}"/>
  </joint>

  <!-- Speaker (siren / voice) facing backward -->
  <link name="speaker_link">
    <visual>
      <origin rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="0.03" length="0.008"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="speaker_joint" type="fixed">
    <parent link="base_link"/>
    <child link="speaker_link"/>
    <origin xyz="${-body_radius} 0 0.32" rpy="0 0 ${pi}"/>
  </joint>

  <!-- Beacon light band around the body (visual only) -->
  <link name="beacon_band_link">
    <visual>
      <geometry><cylinder radius="${body_radius + 0.003}" length="0.02"/></geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="beacon_band_joint" type="fixed">
    <parent link="base_link"/>
    <child link="beacon_band_link"/>
    <origin xyz="0 0 0.29"/>
  </joint>

  <!-- ===== Top: 360 deg LiDAR, nothing above it ===== -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 ${(upper_top - lidar_z)/2}"/>
      <geometry><cylinder radius="0.025" length="${lidar_z - upper_top}"/></geometry>
      <material name="grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.0025"/>
      <geometry><cylinder radius="0.035" length="0.045"/></geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="5e-5" ixy="0" ixz="0" iyy="5e-5" iyz="0" izz="5e-5"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} 0 ${lidar_z}"/>
  </joint>

  <!-- ===== Gazebo sensors (interfaces unchanged) ===== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>lidar_link</gz_frame_id>
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.12414</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="thermal_link">
    <sensor name="thermal_camera" type="thermal">
      <gz_frame_id>thermal_link</gz_frame_id>
      <topic>/thermal/image</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>${thermal_hfov}</horizontal_fov>
        <image>
          <width>160</width>
          <height>120</height>
          <!-- L16: pixel value = temperature / 0.01 K -->
          <format>L16</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Gazebo systems: odom frame -> base_footprint, wheel joint states -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
