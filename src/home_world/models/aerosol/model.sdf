<?xml version="1.0" ?>
<!-- Visual-only solid aerosol release, clearly unlike the dark fire smoke:
     white jet shooting out of the outlet, then spreading into a wide white
     cloud. Spawned at aerosol_outlet_link (model +z = outlet direction) by
     the suppression node and removed after a while. Emitters emit along
     their +x, so they are pitched -90 deg to emit along +z.
     ~80 live particles in total (fire model: ~240) to keep RTF. -->
<sdf version="1.9">
  <model name="aerosol">
    <static>true</static>
    <link name="link">
      <!-- fast narrow jet: 3-4 m/s for 0.5 s, overlapping puffs widening on the way -->
      <particle_emitter name="jet" type="box">
        <emitting>true</emitting>
        <pose>0 0 0.02 0 -1.5708 0</pose>
        <size>0.02 0.05 0.05</size>
        <particle_size>0.2 0.2 0.2</particle_size>
        <lifetime>0.5</lifetime>
        <rate>80</rate>
        <min_velocity>3.0</min_velocity>
        <max_velocity>4.0</max_velocity>
        <scale_rate>3.0</scale_rate>
        <color_start>1 1 1 1</color_start>
        <color_end>0.9 0.9 0.9 1</color_end>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.3 0.3 0.3 1</emissive>
          <pbr><metal><albedo_map>materials/textures/aerosol_white.png</albedo_map></metal></pbr>
        </material>
      </particle_emitter>
      <!-- spreading cloud where the jet slows down (end of the jet) -->
      <particle_emitter name="cloud" type="box">
        <emitting>true</emitting>
        <pose>0 0 1.5 0 -1.5708 0</pose>
        <size>0.3 1.6 1.6</size>
        <particle_size>0.5 0.5 0.5</particle_size>
        <lifetime>4.0</lifetime>
        <rate>10</rate>
        <min_velocity>0.1</min_velocity>
        <max_velocity>0.4</max_velocity>
        <scale_rate>0.8</scale_rate>
        <color_start>1 1 1 1</color_start>
        <color_end>0.85 0.85 0.85 1</color_end>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.15 0.15 0.15 1</emissive>
          <pbr><metal><albedo_map>materials/textures/aerosol_white.png</albedo_map></metal></pbr>
        </material>
      </particle_emitter>
    </link>
  </model>
</sdf>
