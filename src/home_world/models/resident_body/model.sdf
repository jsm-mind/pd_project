<?xml version="1.0"?>
<!-- Invisible heat body of the resident. Gazebo actors get no thermal
     signature, so this cylinder carries 36.5 C (and a collision for lidar)
     where the resident stands. resident_sim hides it while the resident
     walks. Pose = floor center. -->
<sdf version="1.9">
  <model name="resident_body">
    <static>true</static>
    <link name="body">
      <collision name="collision">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry><cylinder><radius>0.18</radius><length>1.5</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry><cylinder><radius>0.18</radius><length>1.5</length></cylinder></geometry>
        <transparency>1.0</transparency>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>309.65</temperature>
        </plugin>
      </visual>
    </link>
  </model>
</sdf>
