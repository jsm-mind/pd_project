    <!-- Fire is spawned by world.launch.py at a random candidate spot (models/fire). -->

    <include>
      <name>charger</name>
      <uri>model://charger</uri>
      <pose>0.6 3.6 0.1 0 0 0</pose>
    </include>

    <include>
      <name>resident</name>
      <uri>model://male_visitor</uri>
      <!-- z = floor: without a script trajectory (FollowActor) the walking
           animation already lifts the root bone to hip height -->
      <pose>8.1 6.4 0.1 0 0 0</pose>
    </include>

    <include>
      <name>resident_body</name>
      <uri>model://resident_body</uri>
      <pose>8.1 6.4 0.1 0 0 0</pose>
    </include>

    <include>
      <name>resident_anchor</name>
      <uri>model://resident_anchor</uri>
      <pose>8.1 6.4 0.1 0 0 0</pose>
    </include>

