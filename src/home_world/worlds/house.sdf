    <!-- Fire is spawned by world.launch.py at a random candidate spot (models/fire). -->

    <include>
      <name>charger</name>
      <uri>model://charger</uri>
      <pose>0.6 3.6 0.1 0 0 0</pose>
    </include>

    <include>
      <name>resident</name>
      <uri>model://male_visitor</uri>
      <!-- Actor script waypoint adds (0, 1, 0): actual position is (8.1, 6.4).
           z = floor 0.1 + hip bone height 0.9 (actor pose is the root bone). -->
      <pose>8.1 5.4 1.0 0 0 0</pose>
    </include>

  </world>
